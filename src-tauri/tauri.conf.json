{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "sgs_ng",
  "version": "0.1.0",
  "identifier": "dev.sgsng.game",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "弈 · 三国杀新章",
        "width": 1440,
        "height": 1000,
        "minWidth": 720,
        "minHeight": 400,
        "backgroundColor": "#111b1a"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost blob: data:; media-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; script-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost blob: data: ws: wss:; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
