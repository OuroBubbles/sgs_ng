{
  "name": "sgs-ng",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 1420 --strictPort",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint src tests scripts examples *.ts *.js",
    "content:build": "node scripts/build-content.mjs",
    "content:example": "node scripts/build-content.mjs examples/content/harbor/index.ts .artifacts/content/harbor.sgs.mjs",
    "content:bundle": "node scripts/build-content.mjs examples/content/harbor/index.ts .artifacts/content/harbor.sgs && node scripts/build-content.mjs examples/content/gallery/index.ts .artifacts/content/gallery.sgs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --reporter=default --reporter=json --outputFile=.artifacts/validation/units.json",
    "test:core": "vitest run tests/scenarios --reporter=default --reporter=json --outputFile=.artifacts/validation/scenarios.json",
    "test:ui": "pnpm content:example && pnpm content:bundle && playwright test",
    "docs:check": "node scripts/check-doc-links.mjs",
    "audit:standard": "node scripts/audit-standard.mjs",
    "audit:standard:behavior": "node scripts/audit-standard-behavior.mjs",
    "audit:portraits": "node scripts/audit-portraits.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm docs:check && pnpm test && pnpm audit:standard:behavior --complete && pnpm build",
    "platform:check": "pwsh -NoProfile -File scripts/native.ps1 -Task check",
    "tauri": "tauri",
    "desktop:build": "pwsh -NoProfile -File scripts/native.ps1 -Task desktop",
    "desktop:debug": "pwsh -NoProfile -File scripts/native.ps1 -Task desktop-debug",
    "desktop:verify": "pwsh -NoProfile -File scripts/verify-windows.ps1",
    "desktop:package": "pwsh -NoProfile -File scripts/package-windows.ps1",
    "android:init": "pwsh -NoProfile -File scripts/native.ps1 -Task android-init",
    "android:build": "pwsh -NoProfile -File scripts/android-package.ps1",
    "assets:fetch": "node scripts/fetch-spine.mjs"
  },
  "dependencies": {
    "@esotericsoftware/spine-pixi-v8": "4.2.120",
    "fflate": "0.8.3",
    "pixi.js": "8.22.0",
    "svelte": "5.57.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tauri-apps/cli": "2.12.3",
    "@types/node": "24.10.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "16.5.0",
    "prettier": "3.6.2",
    "prettier-plugin-svelte": "3.4.1",
    "svelte-check": "4.7.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
