{
  "name": "sgs-ng",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 1420 --strictPort",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint src tests scripts examples *.ts *.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:ui": "pnpm server:build && node scripts/build-server.mjs tests/fixtures/network-host.ts .artifacts/network-fixture && playwright test",
    "docs:check": "node scripts/check-doc-links.mjs",
    "audit:portraits": "node scripts/audit-portraits.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "platform:check": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/native.ps1 -Task check",
    "tauri": "tauri",
    "desktop:build": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/native.ps1 -Task desktop",
    "desktop:debug": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/native.ps1 -Task desktop-debug",
    "desktop:verify": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/verify-windows.ps1",
    "desktop:package": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/package-windows.ps1",
    "android:init": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/native.ps1 -Task android-init",
    "android:build": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/android-package.ps1",
    "assets:fetch": "node scripts/fetch-spine.mjs",
    "server:build": "node scripts/build-server.mjs",
    "host:build": "node scripts/build-desktop-host.mjs",
    "server:start": "node .artifacts/server/main.mjs",
    "online": "pnpm build && pnpm server:build && pnpm server:start",
    "desktop:network": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/verify-windows.ps1 -Network"
  },
  "dependencies": {
    "@esotericsoftware/spine-pixi-v8": "4.2.120",
    "@tauri-apps/api": "2.12.4",
    "pixi.js": "8.22.0",
    "svelte": "5.57.2",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tauri-apps/cli": "2.12.3",
    "@types/node": "24.10.1",
    "@types/ws": "8.18.2",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "16.5.0",
    "prettier": "3.6.2",
    "prettier-plugin-svelte": "3.4.1",
    "svelte-check": "4.7.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
